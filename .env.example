# App
APP_ENV=development
APP_VERSION=0.1.0
FRONTEND_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# Optional persistence/auth integrations
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Frontend-safe Supabase Auth settings (copy into apps/web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM providers (leave empty to use deterministic demo adapters locally)
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=demo
LLM_TIMEOUT_SECONDS=25
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Search provider (leave empty to use deterministic demo adapter locally)
SEARCH_PROVIDER=demo
SEARCH_API_KEY=
SEARCH_TIMEOUT_SECONDS=10

# Identity / abuse controls
ANON_ID_HMAC_SECRET=replace-with-a-long-random-secret
ANON_RUNS_PER_DAY=5
AUTH_RUNS_PER_DAY=15
ANON_CONCURRENT_RUNS=1
AUTH_CONCURRENT_RUNS=2
HTTP_REQUESTS_PER_MINUTE_ANON=30
HTTP_REQUESTS_PER_MINUTE_AUTH=60

# Run budgets
MAX_QUESTION_CHARS=1500
MAX_SEARCH_QUERIES=3
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_FETCHED_PAGES=6
MAX_FETCH_BYTES=3000000
FETCH_TIMEOUT_SECONDS=8
FETCH_CONCURRENCY=3
MAX_EXTRACTED_CHARS_PER_SOURCE=12000
MAX_TOTAL_CONTEXT_CHARS=50000
MAX_LLM_CALLS_PER_RUN=3
MAX_INPUT_TOKENS_PER_RUN=18000
MAX_OUTPUT_TOKENS_PER_RUN=2500

# Logging / feature flags
LOG_LEVEL=INFO
STORE_QUESTION_TEXT=false
ENABLE_AUTH=false
ENABLE_HISTORY=true
ENABLE_FALLBACK_PROVIDER=true
ENABLE_DEBUG_USAGE=false
